PORT=3000
HOST=127.0.0.1
# Required for admin login. Choose your own password (at least 12 characters).
ADMIN_PASSWORD=
# Leave empty for local SQLite storage.
DATABASE_URL=
# Optional external search; database search remains available on failure.
MEILISEARCH_URL=
MEILISEARCH_KEY=
# demo = simulated payment, stripe = Stripe Checkout, paysolutions = Payso Secure Link
PAYMENT_PROVIDER=demo
PUBLIC_URL=http://127.0.0.1:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pay Solutions / Payso: 8-digit ID and the shop name from https://pay.sn/SHOP_NAME
# PUBLIC_URL must be the public HTTPS origin reachable by Payso postbacks.
PAYSOLUTIONS_MERCHANT_ID=
PAYSOLUTIONS_SHOP_NAME=
PAYSOLUTIONS_API_KEY=
PAYSOLUTIONS_SECRET_KEY=
