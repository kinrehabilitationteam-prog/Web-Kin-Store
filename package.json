{
  "name": "baan-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "dev": "node --watch --env-file-if-exists=.env src/main.js",
    "test": "node --test",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.mjs",
    "db:init": "node --env-file-if-exists=.env scripts/init-database.mjs",
    "db:verify-stock": "node --env-file-if-exists=.env scripts/verify-neon-stock.mjs",
    "format": "prettier --write public src tests scripts README.md compose.yaml package.json",
    "format:check": "prettier --check public src tests scripts README.md compose.yaml package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6"
  }
}
